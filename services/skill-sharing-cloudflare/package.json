{
  "name": "autodesk-skill-sharing-cloudflare",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node tests/service.test.mjs && node tests/review.test.mjs",
    "test:runtime": "wrangler deploy --dry-run --outdir .wrangler/check && node tests/runtime.mjs",
    "check": "wrangler deploy --dry-run",
    "dev": "wrangler dev",
    "migrate:local": "wrangler d1 migrations apply autodesk-skills --local",
    "migrate:remote": "wrangler d1 migrations apply autodesk-skills --remote",
    "deploy": "wrangler deploy"
  },
  "devDependencies": { "wrangler": "4.154.0", "miniflare": "5.20261023.1-beta" }
}
